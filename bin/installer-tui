#!/bin/sh
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# installer-tui: the text front end of the installer.
#
# The pages are, in order: welcome, keyboard, timezone, disk, users, network,
# summary, install and finish.  Every dialog has one primary action and the
# other button is always Back.  Enter always accepts the default.
#
# The answers the pages collect are written to a KEY=value file that the
# backend reads.  A field whose gate is off never reaches that file.
#
# The dialog tool draws its screen on standard output and writes the choice
# of the user to the file descriptor it is given.  The screen has to reach
# the terminal, so the terminal is kept on file descriptor 3 and the choice
# of the user is read from file descriptor 4.

set -eu

here=$(CDPATH= cd "$(dirname "$0")" && pwd)
. "${here}/../lib/rootguard.sh"
root=${INSTALLER_ROOT:-$(CDPATH= cd "${here}/.." && pwd)}
. "${root}/lib/backend.sh"
. "${root}/lib/config.sh"
. "${root}/lib/accounts.sh"

BACKEND="${root}/bin/installer-backend"
# The dialog tool.  bsddialog(1) is in the base of FreeBSD; OpenBSD and
# NetBSD package dialog(1), which takes the same arguments; without either
# the installer asks its questions with plain prompts on the terminal
# (bin/installer-prompt).  BSDDIALOG names another tool (tests, rehearsals;
# never honoured for root).
if [ -z "${BSDDIALOG:-}" ]; then
	if command -v bsddialog >/dev/null 2>&1; then
		BSDDIALOG=bsddialog
	elif command -v dialog >/dev/null 2>&1; then
		BSDDIALOG=dialog
	else
		BSDDIALOG="${root}/bin/installer-prompt"
	fi
fi
# The exit code of the escape key: dialog(1) answers it with 255, bsddialog
# and the prompts with 5.
case "${BSDDIALOG##*/}" in
	*bsddialog*|installer-prompt) DLG_ESCAPE=5 ;;
	*dialog) DLG_ESCAPE=255 ;;
	*) DLG_ESCAPE=5 ;;
esac

# die <exit code> <message...> — stop with a message on standard error.
#
# The front end has a name of its own: the message of the front end says
# that the front end is the one that stopped.
die() {
	_code=$1
	shift
	printf 'installer-tui: %s\n' "$*" >&2
	exit "${_code}"
}

PAGES='welcome keyboard timezone disk users network software summary install finish'

TAB=$(printf '\t')

# The terminal, for the screens of the dialog tool.
exec 3>&1

state=''
state_parent=${INSTALLER_STATE_PARENT:-${TMPDIR:-/tmp}}
answers_file=''
log=''
log_destination=''

product=''
default_keymap=''
os_name=''
default_timezone=''

keymap=''
timezone=''
disk=''
disk_descr=''
disk_size=''
user_name=''
user_password=''
user_auth=password
privilege_passwordless=no
secret_written=no
secret_password=''
secret_hash=''
hash_scheme=sha512
network_mode=dhcp
accept_licenses=''
net_if=''
ipv4_addr=''
ipv4_mask=''
ipv4_gw=''
locale=''
clock=utc
root_mode=locked
root_password=''
root_written=''
autologin=no
ipv6_mode=slaac
ipv6_addr=''
ipv6_gw=''
dns_servers=''
update_after=no
wifi_ssid=''
wifi_security=''
wifi_psk=''

installed=0
install_failed=0
stop_reason=''
probe_detail=''
DLG_RC=0
DLG_OUT=''
DLG_TITLE=''

# remove_state — remove the state directory of the run.  The path has to be
# a directory under the parent directory of the state.
remove_state() {
	[ -n "${state}" ] || return 0
	[ -n "${state_parent}" ] || return 0
	[ "${state}" != "${state_parent}" ] || return 0
	case "${state}" in
		"${state_parent}"/*) : ;;
		*) return 0 ;;
	esac
	[ -d "${state}" ] || return 0
	rm -rf -- "${state}"
}

# publish_log — keep the log of the run in the place it is documented.
#
# The log itself lives in the state directory of the run, which is private
# and is gone when the run ends.  The copy that is kept is made in a file of
# its own next to the destination and is moved into place afterwards, so a
# link that is in the way is never followed and never written through.
publish_log() {
	[ -n "${log}" ] || return 0
	[ -f "${log}" ] || return 0
	[ -n "${log_destination}" ] || return 0
	[ "${log_destination}" != "${log}" ] || return 0
	dir=$(dirname "${log_destination}")
	[ -d "${dir}" ] || return 0
	tmp=$(mktemp "${dir}/.wtfbsd-installer-log.XXXXXX") || return 0
	if ! cat "${log}" > "${tmp}"; then
		rm -f "${tmp}"
		return 0
	fi
	chmod 600 "${tmp}" 2>/dev/null || :
	if ! mv -f "${tmp}" "${log_destination}"; then
		rm -f "${tmp}"
		return 0
	fi
	return 0
}

# cleanup — the state of the run is gone when the run ends.
cleanup() {
	_code=$?
	trap - EXIT INT TERM HUP
	publish_log || :
	remove_state || :
	exit "${_code}"
}

# signal_exit — the run was interrupted.
signal_exit() {
	trap - EXIT INT TERM HUP
	publish_log || :
	remove_state || :
	exit 1
}

# leave — the installer is left.  A run that did not finish ends with a non
# zero code.
leave() {
	if [ "${install_failed}" -eq 1 ]; then
		printf 'installer-tui: the installation did not finish\n' >&2
		exit 1
	fi
	exit 0
}

# dlg <dialog arguments...> — run one dialog.  DLG_OUT holds what the user
# chose and DLG_RC the exit code the dialog tool returned.
#
# The labels of the buttons are part of the arguments: the caller says what
# the buttons of the dialog are called.
#
# The choice of the user is read from file descriptor 4 and the screen of the
# tool goes to the terminal on file descriptor 3.  The escape key asks
# whether to leave the installer; only an answer of yes leaves and every
# other answer brings the same dialog back.
#
# dialog(1) exits with 255 for the escape key and for every error of its
# own, so a tool that fails would bring the same dialog back for ever.  The
# box "Quit the installer?" has two answers, 0 and 1; anything else (an
# error, or for dialog(1) the escape key, which cannot be told from one)
# stops the installer with exit code 3.  The escape key of bsddialog and
# of the prompts (5) on that box is Continue.  Three escapes in a row on the
# same screen stop it as well.
#
# A yes or no box writes nothing: the answer of the user is the exit code
# of the dialog, 0 for yes and 1 for no.  Such a box is given no output
# descriptor at all: there is nothing to read, and a descriptor that points
# at the terminal would let the tool write to it.
dlg() {
	_escapes=0
	while :; do
		DLG_RC=0
		DLG_OUT=''
		if has_yesno "$@"; then
			"$BSDDIALOG" --title "${DLG_TITLE}" "$@" \
				1>&3 2>>"${log}" || DLG_RC=$?
		else
			DLG_OUT=$("$BSDDIALOG" --title "${DLG_TITLE}" --output-fd 4 "$@" \
				4>&1 1>&3 2>>"${log}") || DLG_RC=$?
		fi
		if [ "${DLG_RC}" -ne "${DLG_ESCAPE}" ]; then
			break
		fi
		_escapes=$((_escapes + 1))
		if [ "${_escapes}" -ge 3 ]; then
			die 3 "the dialog tool ${BSDDIALOG} returned ${DLG_ESCAPE} three times in a row on the same screen (the escape key or an error of the tool); see ${log_destination:-${log}}"
		fi
		DLG_RC=0
		DLG_OUT=''
		"$BSDDIALOG" --title "${DLG_TITLE}" --yes-label Quit --no-label Continue \
			--yesno "Quit the installer?" \
			0 0 1>&3 2>>"${log}" || DLG_RC=$?
		case "${DLG_RC}" in
			0)
				DLG_RC=9
				break
				;;
			1) : ;;
			*)
				if [ "${DLG_RC}" -ne "${DLG_ESCAPE}" ] || [ "${DLG_ESCAPE}" -eq 255 ]; then
					die 3 "the dialog tool ${BSDDIALOG} failed (exit code ${DLG_RC}) on the box \"Quit the installer?\"; see ${log_destination:-${log}}"
				fi
				;;
		esac
		DLG_RC=0
	done
	return 0
}

# has_yesno <dialog arguments...> — succeed when the dialog is a yes or no
# box.  Such a box has no output descriptor.
has_yesno() {
	for _arg in "$@"; do
		if [ "${_arg}" = '--yesno' ]; then
			return 0
		fi
	done
	return 1
}

# dlg_page <dialog arguments...> — a dialog of a page: the buttons are OK
# and Back.
dlg_page() {
	dlg --ok-label OK --cancel-label Back "$@"
}

# dlg_quit <dialog arguments...> — a dialog of a screen that leaves the
# installer: the buttons are OK and Quit.
dlg_quit() {
	dlg --ok-label OK --cancel-label Quit "$@"
}

# dlg_yesno <text> <rows> <cols> — a yes or no box: the buttons are Yes
# and No.
dlg_yesno() {
	dlg --yes-label Yes --no-label No --yesno "$@"
}

# page_index <page> — the position of a page in the page order.
page_index() {
	index=1
	for page in ${PAGES}; do
		if [ "${page}" = "$1" ]; then
			printf '%s\n' "${index}"
			return 0
		fi
		index=$((index + 1))
	done
	printf '0\n'
}

# page_at <index> — the page at that position.
page_at() {
	index=1
	for page in ${PAGES}; do
		if [ "${index}" -eq "$1" ]; then
			printf '%s\n' "${page}"
			return 0
		fi
		index=$((index + 1))
	done
	printf 'finish\n'
}

page_next() {
	index=$(page_index "$1")
	page_at $((index + 1))
}

page_prev() {
	index=$(page_index "$1")
	if [ "${index}" -gt 1 ]; then
		page_at $((index - 1))
	else
		printf 'welcome\n'
	fi
}

# json_items <json> <key> — the items of a JSON array, one per line, as
# "name<TAB>description<TAB>size".
json_items() {
	printf '%s' "$1" | python3 -I -B -c '
import json, sys


def human(size):
    try:
        size = int(size)
    except (TypeError, ValueError):
        size = 0
    if size <= 0:
        return "unknown size"
    value = float(size)
    for unit in ("bytes", "KB", "MB", "GB", "TB"):
        if value < 1024 or unit == "TB":
            if unit == "bytes":
                return "%d bytes" % int(value)
            return "%.1f %s" % (value, unit)
        value = value / 1024.0
    return "%d bytes" % size


try:
    data = json.load(sys.stdin)
except ValueError:
    data = {}
for item in data.get(sys.argv[1]) or []:
    if isinstance(item, dict):
        sys.stdout.write("%s\t%s\t%s\n" % (
            item.get("name", ""),
            item.get("descr", ""),
            human(item.get("size_bytes", 0)),
        ))
    else:
        sys.stdout.write("%s\t\tunknown size\n" % item)
' "$2"
}

# json_value <json> <key> — one value of a JSON object.
json_value() {
	printf '%s' "$1" | python3 -I -B -c '
import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    data = {}
sys.stdout.write("%s" % data.get(sys.argv[1], ""))
' "$2"
}

# write_answers — write the answers the backend reads.  The gating module
# decides which fields survive.
#
# The password of the account is never written anywhere: it is turned into
# a crypt hash in the scheme of the system (lib/passhash.py reads it on
# standard input, so it is never on a command line either) and only the
# hash is written, to a file of mode 0600 in a directory of mode 0700.  The
# file is made in a file of its own and moved into place, and a hash file
# that this run did not write is never written over.
#
# The answers reach the file of the answers through the gate: the gate
# writes a file of its own and the file of the answers is only replaced
# when the gate was happy with the answers.
write_answers() {
	secrets="${state}/secrets"
	if [ ! -d "${secrets}" ]; then
		mkdir -p "${secrets}" || return 1
		chmod 700 "${secrets}" || return 1
	fi
	if [ "${user_auth}" = password ]; then
		hashfile="${secrets}/user.hash"
		if [ -e "${hashfile}" ] || [ -L "${hashfile}" ]; then
			# A hash file that this run did not write, or that was
			# changed since, is never written over.
			held=$(cat "${hashfile}" 2>/dev/null || printf '')
			if [ "${secret_written}" != yes ] || [ -L "${hashfile}" ] ||
				[ "${held}" != "${secret_hash}" ]; then
				return 1
			fi
		fi
		if [ ! -e "${hashfile}" ] || [ "${secret_password}" != "${user_password}" ]; then
			# printf is built into the shell: the password is never
			# on a command line.
			if ! printf '%s\n' "${user_password}" |
				python3 -I -B "${root}/lib/passhash.py" write "${hash_scheme}" \
					"${hashfile}" 2>>"${log}"; then
				return 1
			fi
			secret_hash=$(cat "${hashfile}") || return 1
			secret_written=yes
			secret_password=${user_password}
		fi
	fi
	# The password of root: only its hash, like the account's, and only
	# when root gets a password of its own (locked by default).
	if [ "${root_mode}" = password ]; then
		roothash="${secrets}/root.hash"
		if [ ! -e "${roothash}" ] || [ "${root_written}" != "${root_password}" ]; then
			rm -f "${roothash}"
			if ! printf '%s\n' "${root_password}" |
				python3 -I -B "${root}/lib/passhash.py" write "${hash_scheme}" \
					"${roothash}" 2>>"${log}"; then
				return 1
			fi
			root_written=${root_password}
		fi
	else
		rm -f "${secrets}/root.hash"
	fi
	# The Wi-Fi network and its passphrase: a 0600 file, the passphrase on
	# standard input, never on a command line.
	rm -f "${secrets}/wifi.json"
	if [ -n "${wifi_ssid}" ]; then
		if ! printf '%s\n' "${wifi_psk}" | WIFI_IF="${net_if}" WIFI_SSID="${wifi_ssid}" \
			WIFI_SECURITY="${wifi_security}" python3 -I -B -c '
import json, os, sys
psk = sys.stdin.readline().rstrip("\n")
data = json.dumps({"if": os.environ["WIFI_IF"], "ssid": os.environ["WIFI_SSID"],
                   "security": os.environ["WIFI_SECURITY"], "psk": psk}).encode("utf-8")
fd = os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, "wb") as stream:
    stream.write(data)
' "${secrets}/wifi.json" 2>>"${log}"; then
			return 1
		fi
	fi
	raw="${state}/answers.raw"
	gated="${state}/answers.gated"
	{
		printf 'KEYMAP=%s\n' "${keymap}"
		if [ -n "${locale}" ]; then
			printf 'LOCALE=%s\n' "${locale}"
		fi
		printf 'TIMEZONE=%s\n' "${timezone}"
		printf 'CLOCK=%s\n' "${clock}"
		printf 'DISK=%s\n' "${disk}"
		printf 'USER_NAME=%s\n' "${user_name}"
		printf 'USER_AUTH=%s\n' "${user_auth}"
		if [ "${user_auth}" = password ]; then
			printf 'USER_HASHFILE=%s\n' "${secrets}/user.hash"
		fi
		printf 'PRIVILEGE_PASSWORDLESS=%s\n' "${privilege_passwordless}"
		printf 'NETWORK_MODE=%s\n' "${network_mode}"
		if [ -n "${accept_licenses}" ]; then
			printf 'ACCEPT_LICENSES=%s\n' "${accept_licenses}"
		fi
		printf 'NET_IF=%s\n' "${net_if}"
		if [ "${network_mode}" = static ]; then
			printf 'NET_IPV4=static\n'
			printf 'IPV4_ADDR=%s\n' "${ipv4_addr}"
			printf 'IPV4_MASK=%s\n' "${ipv4_mask}"
			printf 'IPV4_GW=%s\n' "${ipv4_gw}"
		fi
		printf 'ROOT_MODE=%s\n' "${root_mode}"
		if [ "${root_mode}" = password ]; then
			printf 'ROOT_HASHFILE=%s\n' "${secrets}/root.hash"
		fi
		printf 'AUTOLOGIN=%s\n' "${autologin}"
		# The lists of the network (lib/netplan.py), as the graphical
		# front end writes them.
		if [ "${network_mode}" != offline ] && [ -n "${net_if}" ]; then
			case "${network_mode}" in
				static) printf 'NET_IPV4_LIST=%s:%s/%s:%s\n' "${net_if}" \
					"${ipv4_addr}" "${ipv4_mask}" "${ipv4_gw}" ;;
				*) printf 'NET_IPV4_LIST=%s:dhcp\n' "${net_if}" ;;
			esac
			case "${ipv6_mode}" in
				slaac) printf 'NET_IPV6_LIST=%s:slaac\n' "${net_if}" ;;
				static) printf 'NET_IPV6_LIST=%s:%s:%s\n' "${net_if}" \
					"${ipv6_addr}" "${ipv6_gw}" ;;
			esac
			if [ -n "${dns_servers}" ]; then
				printf 'DNS_SERVERS=%s\n' "${dns_servers}"
			fi
			if [ "${update_after}" = yes ]; then
				printf 'UPDATE_AFTER=yes\n'
			fi
			if [ -n "${wifi_ssid}" ]; then
				printf 'WIFI_FILE=%s\n' "${secrets}/wifi.json"
			fi
		fi
	} > "${raw}"
	# The gate writes a file of its own.  The file of the answers is only
	# replaced when the gate was happy with the answers, so a gate that
	# fails never leaves an empty file of answers behind.
	if ! python3 -I -B "${root}/lib/gating.py" gate "${raw}" > "${gated}"; then
		rm -f "${gated}"
		return 1
	fi
	if ! mv -f "${gated}" "${answers_file}"; then
		rm -f "${gated}"
		return 1
	fi
	if ! python3 -I -B "${root}/lib/gating.py" secrets "${raw}" \
		> "${state}/consumed-secrets.txt"; then
		return 1
	fi
	return 0
}

# delete_secrets — the hash of the password is gone once the backend has
# read it.
delete_secrets() {
	[ -n "${state}" ] || return 0
	rm -f "${state}/secrets/user.hash" "${state}/secrets/answers.conf" \
		"${state}/secrets/plan.json" \
		"${state}/secrets/root.hash" "${state}/secrets/wifi.json"
}

summary_text() {
	printf 'The installation will use:\n\n'
	printf '  Product:     %s\n' "${product}"
	if [ -n "${locale}" ]; then
		printf '  Language:    %s\n' "${locale}"
	fi
	printf '  Keyboard:    %s\n' "${keymap}"
	if [ "${clock}" = local ]; then
		printf '  Time zone:   %s (the hardware clock keeps local time)\n' "${timezone}"
	else
		printf '  Time zone:   %s\n' "${timezone}"
	fi
	printf '  Disk:        %s\n' "${disk}"
	printf '  User:        %s\n' "${user_name}"
	printf '  Privileges:  %s\n' "$(privilege_text)"
	if [ "${root_mode}" = password ]; then
		printf '  Root:        a password of its own\n'
	else
		printf '  Root:        locked (use sudo or doas)\n'
	fi
	if [ "${autologin}" = yes ]; then
		printf '  Log in:      automatically as %s\n' "${user_name}"
	fi
	printf '  Network:     %s\n' "$(network_text)"
	if [ -n "${accept_licenses}" ]; then
		printf '  Additional software (licences accepted): %s\n' \
			"$(printf '%s' "${accept_licenses}" | sed 's/,/, /g')"
	fi
	network_detail
	printf '\nThis will erase %s (%s, %s).\n' \
		"${disk}" "${disk_descr}" "${disk_size}"
}

privilege_text() {
	if [ "${privilege_passwordless}" = yes ]; then
		printf 'passwordless sudo and doas\n'
	else
		printf 'a password for sudo and doas\n'
	fi
}

network_text() {
	case "${network_mode}" in
		static) printf 'a manual address on %s\n' "${net_if}" ;;
		offline) printf 'no network\n' ;;
		*) printf 'an automatic address on %s\n' "${net_if}" ;;
	esac
}

# network_detail — the lines of the network that the one line summary does
# not hold: the address, the netmask and the gateway of a manual address.
network_detail() {
	[ "${network_mode}" != offline ] || return 0
	if [ "${network_mode}" = static ]; then
		printf '  Address:     %s\n' "${ipv4_addr}"
		printf '  Netmask:     %s\n' "${ipv4_mask}"
		printf '  Gateway:     %s\n' "${ipv4_gw}"
	fi
	case "${ipv6_mode}" in
		slaac) printf '  IPv6:        automatic (SLAAC)\n' ;;
		static) printf '  IPv6:        %s, gateway %s\n' "${ipv6_addr}" "${ipv6_gw:-none}" ;;
		*) printf '  IPv6:        off\n' ;;
	esac
	if [ -n "${dns_servers}" ]; then
		printf '  DNS:         %s\n' "$(printf '%s' "${dns_servers}" | sed 's/,/, /g')"
	fi
	if [ -n "${wifi_ssid}" ]; then
		printf '  Wi-Fi:       %s (%s)\n' "${wifi_ssid}" "${wifi_security}"
	fi
	if [ "${update_after}" = yes ]; then
		printf '  Updates:     installed after the installation\n'
	fi
}

# probe_message <file> — the message the backend wrote on standard error.
#
# The message goes to the log of the run as well, so that it is kept when
# the run ends.  It is returned as one line: the screen that shows it has
# one line for it.
probe_message() {
	_file=${1:-}
	[ -n "${_file}" ] || return 0
	[ -f "${_file}" ] || return 0
	cat "${_file}" >> "${log}" 2>/dev/null || :
	tr '\n' ' ' < "${_file}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# stop_reason_for <requirement> <detected> — keep the reason why the run
# cannot go on.  The message that the run prints when it stops names it.
stop_reason_for() {
	stop_reason="the requirement '$1' was not met ($2)"
}

# unfortunately <requirement> <detected> <needed> <may override> <probe>
#
# The screen asks what to do about a requirement the machine does not meet.
# The override is only offered when it can help, which is when the machine
# has a disk to install to, and choosing it asks for a confirmation first.
# Staying in the live system leaves the installer without installing
# anything.
#
# The probe is the name of a function that looks for the hardware again.  It
# returns 0 when the requirement is met and it leaves the name of what it
# found in probe_result.
#
# The screen returns 0 when the run may go on, 5 when the user wants to stay
# in the live system, 9 when the user wants to leave the installer and 3 when
# the run cannot go on at all.
unfortunately() {
	requirement=$1
	detected=$2
	needed=$3
	may_override=$4
	probe=$5
	DLG_TITLE="${product} Installer [Unfortunately]"
	while :; do
		set -- --menu "Unfortunately

Requirement: ${requirement}
Detected:   ${detected}${probe_detail:+ (${probe_detail})}
Needed:     ${needed}

Choose Rescan to look for the hardware again, Override to continue without the requirement, or Quit to leave the installer and stay in the live system." 0 0 8 \
			Rescan 'Look for the hardware again'
		if [ "${may_override}" = yes ]; then
			set -- "$@" Override 'Continue without the requirement'
		fi
		set -- "$@" Quit 'Stay in the live system and do not install anything'
		dlg_quit "$@"
		if [ "${DLG_RC}" -eq 9 ]; then
			return 9
		fi
		case "${DLG_RC}" in
			0)
				case "${DLG_OUT}" in
					Rescan)
						if "${probe}"; then
							return 0
						fi
						detected=${probe_result}
						continue
						;;
					Override)
						dlg_yesno "The requirement is not met.

Continue anyway?" 0 0
						if [ "${DLG_RC}" -eq 9 ]; then
							return 9
						fi
						case "${DLG_RC}" in
							0) return 0 ;;
							*) continue ;;
						esac
						;;
					Quit) return 5 ;;
					*)
						stop_reason_for "${requirement}" "${detected}"
						return 3
						;;
				esac
				;;
			1)
				stop_reason_for "${requirement}" "${detected}"
				return 3
				;;
			*)
				stop_reason_for "${requirement}" "${detected}"
				return 3
				;;
		esac
	done
}

# probe_disks — look for a disk to install to.
#
# The names of the disks that were found are left in probe_result and the
# function returns 0 when there is at least one of them.  The message of the
# backend is left in probe_detail, so that the screen can say why the
# hardware could not be read.
probe_disks() {
	disks_exist=no
	probe_result='none found'
	answer=$("$BACKEND" disk probe 2>"${state}/probe-disks.err") ||
		answer='{"disks":[]}'
	probe_detail=$(probe_message "${state}/probe-disks.err")
	json_items "${answer}" disks > "${state}/preflight-disks"
	if [ -s "${state}/preflight-disks" ]; then
		disks_exist=yes
		probe_result=$(cut -f1 "${state}/preflight-disks" | tr '\n' ' ')
		return 0
	fi
	return 1
}

# probe_network — look for a network adapter.
#
# The names of the adapters that were found are left in probe_result and the
# function returns 0 when there is at least one of them.  The message of the
# backend is left in probe_detail.
probe_network() {
	nets_exist=no
	probe_result='none found'
	answer=$("$BACKEND" network probe 2>"${state}/probe-network.err") ||
		answer='{"interfaces":[]}'
	probe_detail=$(probe_message "${state}/probe-network.err")
	json_items "${answer}" interfaces > "${state}/preflight-interfaces"
	if [ -s "${state}/preflight-interfaces" ]; then
		nets_exist=yes
		probe_result=$(cut -f1 "${state}/preflight-interfaces" | tr '\n' ' ')
		return 0
	fi
	return 1
}

# preflight — the checks that run before the first page.
#
# The machine needs a disk to install to and it may have a network adapter.
# A machine without an adapter can be installed offline, so that requirement
# can be overridden.  A machine without a disk cannot be installed to at
# all: the screen before the first page says so and offers to stay in the
# live system.
preflight() {
	result=0
	if ! probe_disks; then
		unfortunately 'A disk to install to' "${probe_result}" 'one disk' \
			no probe_disks || result=$?
		case "${result}" in
			0) : ;;
			*) return "${result}" ;;
		esac
	fi
	if ! probe_network; then
		result=0
		unfortunately 'A network adapter' "${probe_result}" 'one adapter' \
			"${disks_exist}" probe_network || result=$?
		case "${result}" in
			0)
				if [ "${nets_exist}" = no ]; then
					network_mode=offline
				fi
				;;
			*) return "${result}" ;;
		esac
	fi
	return 0
}

page_welcome() {
	DLG_TITLE="${product} Installer [Welcome]"
	dlg --yes-label Yes --no-label Quit --yesno "Welcome to the ${product} installer.

This installer will guide you through installing ${product} on this machine." 0 0
	case "${DLG_RC}" in
		0) return 0 ;;
		1) return 2 ;;
		*) return 3 ;;
	esac
}

page_keyboard() {
	DLG_TITLE="${product} Installer [Keyboard]"
	probe=$("$BACKEND" keyboard probe 2>>"${log}") || probe='{"layouts":[]}'
	items="${state}/keyboard-items"
	json_items "${probe}" layouts > "${items}"
	fallback=$(json_value "${probe}" default)
	[ -n "${fallback}" ] || fallback="${default_keymap}"
	# The language and region of the system first, when the system has a
	# list of them; the layout of its country is then the one offered.
	locales="${state}/locale-items"
	json_items "${probe}" locales > "${locales}"
	if [ -s "${locales}" ]; then
		set -- --default-item "${locale:-en_US.UTF-8}" \
			--menu 'Choose the language and region of the system.' 0 0 12
		while IFS="${TAB}" read -r name descr size; do
			[ -n "${name}" ] || continue
			set -- "$@" "${name}" "$(LIB="${root}/lib" python3 -I -B -c '
import os, sys
sys.path.insert(0, os.environ["LIB"])
import i18n
lang = i18n.language_of(sys.argv[1])
print(lang[2] if lang else sys.argv[1])
' "${name}" 2>/dev/null || printf '%s' "${name}")"
		done < "${locales}"
		dlg_page "$@"
		case "${DLG_RC}" in
			0) locale=${DLG_OUT:-en_US.UTF-8} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		suggested=$(cut -f1 "${items}" | LIB="${root}/lib" python3 -I -B -c '
import os, sys
sys.path.insert(0, os.environ["LIB"])
import i18n
print(i18n.keymap_for(sys.argv[1], sys.stdin.read().split()) or "")
' "${locale}" 2>/dev/null) || suggested=''
		[ -z "${suggested}" ] || fallback=${suggested}
	fi
	# The options of the dialog tool come before the box: dialog(1) reads
	# nothing after it but the items.
	set --
	if [ -s "${items}" ]; then
		set -- --default-item "${fallback}"
	fi
	set -- "$@" --menu 'Choose the keyboard layout.' 0 0 12
	while IFS="${TAB}" read -r name descr size; do
		[ -n "${name}" ] || continue
		set -- "$@" "${name}" "${descr}"
	done < "${items}"
	dlg_page "$@"
	case "${DLG_RC}" in
		0)
			keymap=${DLG_OUT}
			[ -n "${keymap}" ] || keymap=${fallback}
			return 0
			;;
		1) return 1 ;;
		*) return 3 ;;
	esac
}

page_timezone() {
	DLG_TITLE="${product} Installer [Timezone]"
	probe=$("$BACKEND" timezone probe 2>>"${log}") || probe='{"zones":[]}'
	items="${state}/timezone-items"
	json_items "${probe}" zones > "${items}"
	fallback=$(json_value "${probe}" default)
	[ -n "${fallback}" ] || fallback="${default_timezone}"
	# The options of the dialog tool come before the box: dialog(1) reads
	# nothing after it but the items.
	set --
	if [ -s "${items}" ]; then
		set -- --default-item "${fallback}"
	fi
	set -- "$@" --menu 'Choose the time zone.' 0 0 12
	while IFS="${TAB}" read -r name descr size; do
		[ -n "${name}" ] || continue
		set -- "$@" "${name}" "${descr}"
	done < "${items}"
	dlg_page "$@"
	case "${DLG_RC}" in
		0)
			timezone=${DLG_OUT}
			[ -n "${timezone}" ] || timezone=${fallback}
			;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	# The hardware clock: UTC, or local time for a machine that also
	# starts Windows.
	if [ "${clock}" = local ]; then
		set -- utc 'UTC (the usual choice)' off local 'Local time (a machine that also starts Windows)' on
	else
		set -- utc 'UTC (the usual choice)' on local 'Local time (a machine that also starts Windows)' off
	fi
	dlg_page --radiolist 'What time does the hardware clock keep?' 0 0 2 "$@"
	case "${DLG_RC}" in
		0)
			case "${DLG_OUT}" in
				local) clock=local ;;
				*) clock=utc ;;
			esac
			return 0
			;;
		1) return 1 ;;
		*) return 3 ;;
	esac
}

page_disk() {
	DLG_TITLE="${product} Installer [Disk]"
	while :; do
		probe=$("$BACKEND" disk probe 2>>"${log}") || probe='{"disks":[]}'
		items="${state}/disk-items"
		json_items "${probe}" disks > "${items}"
		if [ -s "${items}" ]; then
			text="Choose the disk to install ${product} to."
		else
			text="No disks found.

The installer looked for a disk to write to and did not find one."
		fi
		set -- --menu "${text}" 0 0 12
		while IFS="${TAB}" read -r name descr size; do
			[ -n "${name}" ] || continue
			set -- "$@" "${name}" "${descr}"
		done < "${items}"
		set -- "$@" Rescan 'Look for the disks again' \
			Quit 'Stay in the live system and do not install anything'
		dlg_page "$@"
		case "${DLG_RC}" in
			0)
				case "${DLG_OUT}" in
					Rescan) continue ;;
					Quit) return 5 ;;
					*) disk=${DLG_OUT} ;;
				esac
				disk_descr=''
				disk_size=''
				while IFS="${TAB}" read -r name descr size; do
					if [ "${name}" = "${disk}" ]; then
						disk_descr=${descr}
						disk_size=${size}
					fi
				done < "${items}"
				# The report of the disks, for the plan and the
				# confirmation of the summary.
				printf '%s' "${probe}" > "${state}/disk-probe.json"
				return 0
				;;
			1) return 1 ;;
			*) return 3 ;;
		esac
	done
}

# disk_plan <command> — "foreign": what the chosen disk holds that the
# installation deletes (one line, empty when nothing); "write": the plan
# file of the disk page (lib/diskplan.py, version 1) in the secrets: the
# whole disk, one disk, the first filesystem of the system, and the disk
# confirmed when the summary had the word typed (CONFIRMED=yes).
disk_plan() {
	DISK="${disk}" OS_NAME="${os_name}" CONFIRMED="${erase_confirmed:-no}" LIB="${root}/lib" \
		python3 -I -B -c '
import json, os, sys
sys.path.insert(0, os.environ["LIB"])
import diskplan
try:
    with open(sys.argv[2], encoding="utf-8") as stream:
        detail = json.load(stream).get("detail") or {}
except (OSError, ValueError):
    detail = {}
disk = os.environ["DISK"]
found = diskplan.foreign(diskplan.disk_index(detail).get(disk, {}))
if sys.argv[1] == "foreign":
    print(", ".join(found))
    sys.exit(0)
os_name = os.environ["OS_NAME"]
plan = {"version": 1, "mode": "erase", "disks": [disk], "layout": "single",
        "filesystem": diskplan.system(os_name, detail)["filesystems"][0][0]}
if found and os.environ["CONFIRMED"] == "yes":
    plan["confirm_foreign"] = [disk]
fd = os.open(sys.argv[3], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as stream:
    json.dump(plan, stream)
' "$1" "${state}/disk-probe.json" "${state}/secrets/plan.json"
}

page_users() {
	DLG_TITLE="${product} Installer [Users]"
	while :; do
		dlg_page --inputbox 'User name for the first account:' 0 0 ''
		case "${DLG_RC}" in
			0) user_name=${DLG_OUT} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		if user_name_valid "${user_name}"; then
			break
		fi
		if user_name_reserved "${user_name}"; then
			dlg_page --msgbox "The name '${user_name}' cannot be used: it is a name the system uses.

Choose another name." 0 0
		else
			dlg_page --msgbox "The name '${user_name}' cannot be used.

A name starts with a letter or an underline and holds letters, digits, underlines and dashes." 0 0
		fi
	done
	user_auth=password
	while :; do
		dlg_page --passwordbox "Password for ${user_name}:" 0 0 ''
		case "${DLG_RC}" in
			0) user_password=${DLG_OUT} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		if [ -z "${user_password}" ]; then
			# The installed system needs a password for the account:
			# the install command takes its hash.  An empty password is
			# asked again.
			dlg_page --msgbox "A password is needed for ${user_name}.

Type a password for the account." 0 0
			case "${DLG_RC}" in
				0|1) continue ;;
				*) return 3 ;;
			esac
		fi
		dlg_page --passwordbox "Repeat the password for ${user_name}:" 0 0 ''
		case "${DLG_RC}" in
			0) repeat=${DLG_OUT} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		if [ "${user_password}" = "${repeat}" ]; then
			break
		fi
		dlg_page --msgbox 'The passwords do not match. Type them again.' 0 0
	done
	privilege_passwordless=no
	autologin=no
	dlg_page --checklist "Privileged access for ${user_name}:" 0 0 3 \
		priv 'Passwordless sudo and doas for this account' off \
		autologin "Log in as ${user_name} without the password" off
	case "${DLG_RC}" in
		0)
			case " ${DLG_OUT} " in
				*' priv '*) privilege_passwordless=yes ;;
			esac
			case " ${DLG_OUT} " in
				*' autologin '*) autologin=yes ;;
			esac
			;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	# Root: locked (the account uses sudo or doas), or a password of its own.
	dlg_page --radiolist 'The root account:' 0 0 2 \
		locked 'Locked: use sudo or doas from your account' on \
		password 'A password of its own' off
	case "${DLG_RC}" in
		0) root_mode=${DLG_OUT:-locked} ;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	[ "${root_mode}" = password ] || { root_mode=locked; root_password=''; return 0; }
	while :; do
		dlg_page --passwordbox 'Password for root:' 0 0 ''
		case "${DLG_RC}" in
			0) root_password=${DLG_OUT} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		if [ -z "${root_password}" ]; then
			dlg_page --msgbox 'A password is needed for root, or choose Locked.' 0 0
			case "${DLG_RC}" in
				0|1) continue ;;
				*) return 3 ;;
			esac
		fi
		dlg_page --passwordbox 'Repeat the password for root:' 0 0 ''
		case "${DLG_RC}" in
			0) repeat=${DLG_OUT} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		[ "${root_password}" = "${repeat}" ] && break
		dlg_page --msgbox 'The passwords do not match. Type them again.' 0 0
	done
	return 0
}

page_network() {
	DLG_TITLE="${product} Installer [Network]"
	while :; do
		probe=$("$BACKEND" network probe 2>>"${log}") || probe='{"interfaces":[]}'
		items="${state}/network-items"
		json_items "${probe}" interfaces > "${items}"
		if [ -s "${items}" ]; then
			text='Choose the network adapter.'
			set -- --menu "${text}" 0 0 12
			while IFS="${TAB}" read -r name descr size; do
				[ -n "${name}" ] || continue
				set -- "$@" "${name}" "${descr}"
			done < "${items}"
			set -- "$@" Rescan 'Look for the adapters again' \
				Offline 'Continue offline and install the system without a network'
		else
			text="No network adapters found.

The installation can continue without a network."
			set -- --menu "${text}" 0 0 12 \
				Offline 'Continue offline and install the system without a network' \
				Rescan 'Look for the adapters again'
		fi
		dlg_page "$@"
		case "${DLG_RC}" in
			0)
				case "${DLG_OUT}" in
					Rescan) continue ;;
					Offline)
						network_mode=offline
						net_if=''
						return 0
						;;
					Stay) return 5 ;;
					*) net_if=${DLG_OUT} ;;
				esac
				;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		break
	done
	dlg_page --radiolist "How should ${product} be connected?" 0 0 3 \
		dhcp 'Automatic address (DHCP)' on static 'Manual address' off
	case "${DLG_RC}" in
		0) network_mode=${DLG_OUT} ;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	[ -n "${network_mode}" ] || network_mode=dhcp
	case "${network_mode}" in
		static)
			dlg_page --inputbox "Address for ${net_if}:" 0 0 ''
			case "${DLG_RC}" in
				0) ipv4_addr=${DLG_OUT} ;;
				1) return 1 ;;
				*) return 3 ;;
			esac
			dlg_page --inputbox "Netmask for ${net_if}:" 0 0 ''
			case "${DLG_RC}" in
				0) ipv4_mask=${DLG_OUT} ;;
				1) return 1 ;;
				*) return 3 ;;
			esac
			dlg_page --inputbox "Gateway for ${net_if}:" 0 0 ''
			case "${DLG_RC}" in
				0) ipv4_gw=${DLG_OUT} ;;
				1) return 1 ;;
				*) return 3 ;;
			esac
			;;
	esac
	page_network_more
}

# page_network_more — Wi-Fi (for a Wi-Fi adapter), IPv6, the resolvers and
# the update after the installation, as on the graphical Network page.
page_network_more() {
	wifi_ssid=''
	wifi_security=''
	wifi_psk=''
	nets="${state}/wifi-items"
	printf '%s' "${probe}" | NET_IF="${net_if}" python3 -I -B -c '
import json, os, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    data = {}
for net in (data.get("wifi") or {}).get(os.environ["NET_IF"], []):
    if isinstance(net, dict):
        print("%s\t%s\t%s" % (net.get("ssid", ""), net.get("security", ""), net.get("signal", 0)))
' > "${nets}" 2>/dev/null || : > "${nets}"
	if [ -s "${nets}" ]; then
		set -- --menu "The Wi-Fi network for ${net_if}:" 0 0 12
		n=0
		while IFS="${TAB}" read -r ssid sec signal; do
			n=$((n + 1))
			set -- "$@" "${n}" "${ssid} (${sec}, ${signal}%)"
		done < "${nets}"
		dlg_page "$@"
		case "${DLG_RC}" in
			0) : ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		pick=${DLG_OUT:-1}
		case "${pick}" in
			''|*[!0-9]*) pick=1 ;;
		esac
		line=$(sed -n "${pick}p" "${nets}")
		wifi_ssid=$(printf '%s' "${line}" | cut -f1)
		wifi_security=$(printf '%s' "${line}" | cut -f2)
		if [ "${wifi_security}" != open ]; then
			while :; do
				dlg_page --passwordbox "Passphrase of ${wifi_ssid}:" 0 0 ''
				case "${DLG_RC}" in
					0) wifi_psk=${DLG_OUT} ;;
					1) return 1 ;;
					*) return 3 ;;
				esac
				case "${#wifi_psk}" in
					[89]|[1-5][0-9]|6[0-4]) break ;;
				esac
				dlg_page --msgbox 'A passphrase has 8 to 63 characters.' 0 0
			done
		fi
	fi
	dlg_page --radiolist "IPv6 on ${net_if}:" 0 0 3 \
		slaac 'Automatic (SLAAC)' on static 'Manual address' off off 'Off' off
	case "${DLG_RC}" in
		0) ipv6_mode=${DLG_OUT:-slaac} ;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	if [ "${ipv6_mode}" = static ]; then
		dlg_page --inputbox "IPv6 address with its prefix length for ${net_if} (ADDRESS/PREFIX):" 0 0 ''
		case "${DLG_RC}" in
			0) ipv6_addr=${DLG_OUT} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		dlg_page --inputbox "IPv6 gateway for ${net_if} (empty: none):" 0 0 ''
		case "${DLG_RC}" in
			0) ipv6_gw=${DLG_OUT} ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
	fi
	dlg_page --inputbox 'DNS servers, separated by commas (empty: from the network):' 0 0 "${dns_servers}"
	case "${DLG_RC}" in
		0) dns_servers=$(printf '%s' "${DLG_OUT}" | tr -d ' ') ;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	dlg_page --checklist 'After the installation:' 0 0 2 \
		update 'Install the updates of the packages (needs the network)' off
	case "${DLG_RC}" in
		0)
			case " ${DLG_OUT} " in
				*' update '*) update_after=yes ;;
				*) update_after=no ;;
			esac
			;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	return 0
}

# software_items — the catalogue of the optional licensed software, one
# item per line: id, name, flags (comma separated), path of the licence
# text, separated by tabs.  The open-source notices come last with the id
# "-notices-".
software_items() {
	"$BACKEND" software probe 2>>"${log}" | LIB="${root}/lib" python3 -I -B -c '
import json, sys
try:
    cat = json.load(sys.stdin)["catalogue"]
except (ValueError, KeyError):
    sys.exit(0)
for item in cat.get("items", []):
    print("\t".join([item["id"], item["name"], ",".join(item["flags"]),
                     item["licence"]["text"]]))
if cat.get("notices"):
    print("\t".join(["-notices-", "Open-source licences", "", cat["notices"]]))
' || :
}

# software_select_all — the ids Select all ticks: every item but those for
# non-commercial use or that need a key from the vendor.
software_select_all() {
	awk -F '\t' '$1 != "-notices-" && $3 !~ /non-commercial|vendor-key/ { print $1 }' "$1"
}

# page_software — the optional software whose licence the user has to
# accept: choose the items (a checklist), Select all, read a licence (a
# pager).  Nothing is chosen for the user.  Without a catalogue there is no
# page.
page_software() {
	DLG_TITLE="${product} Installer [Additional software]"
	items="${state}/software-items"
	software_items > "${items}"
	if ! grep -qv '^-notices-' "${items}"; then
		return 0
	fi
	while :; do
		chosen=$(printf '%s' "${accept_licenses}" | tr ',' ' ')
		[ -n "${chosen}" ] || chosen='nothing'
		dlg_page --menu "This software comes under a licence you have to accept. Choosing an item accepts its licence. Nothing is chosen for you.

Chosen: ${chosen}" 0 0 6 \
			Next 'Go on with the choice above' \
			Choose 'Choose the items (each one accepts its licence)' \
			All 'Select all (not the items for non-commercial use or that need a vendor key)' \
			Read 'Read the licence of an item' \
			Notices 'Read the open-source licences'
		case "${DLG_RC}" in
			0) : ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		case "${DLG_OUT}" in
			Next) return 0 ;;
			Choose)
				set -- --checklist 'Tick the items whose licence you accept.' 0 0 8
				while IFS="${TAB}" read -r id name flags text; do
					[ "${id}" != -notices- ] || continue
					note=${name}
					[ -z "${flags}" ] || note="${name} [${flags}]"
					on=off
					case ",${accept_licenses}," in
						*",${id},"*) on=on ;;
					esac
					set -- "$@" "${id}" "${note}" "${on}"
				done < "${items}"
				dlg_page "$@"
				case "${DLG_RC}" in
					0)
						# The answer of a check list: the tags, maybe quoted.
						picked=$(printf '%s' "${DLG_OUT}" | tr -d '"' | tr ' ' '\n' | grep -v '^$' || :)
						accept_licenses=$(cut -f1 "${items}" | while IFS= read -r id; do
							printf '%s\n' "${picked}" | grep -Fxq -- "${id}" && printf '%s,' "${id}"
						done)
						accept_licenses=${accept_licenses%,}
						;;
					1) : ;;
					*) return 3 ;;
				esac
				;;
			All)
				group=$(software_select_all "${items}")
				all=yes
				for id in ${group}; do
					case ",${accept_licenses}," in
						*",${id},"*) : ;;
						*) all=no ;;
					esac
				done
				keep=$(cut -f1 "${items}" | while IFS= read -r id; do
					case ",${accept_licenses}," in
						*",${id},"*) : ;;
						*) continue ;;
					esac
					printf '%s\n' "${group}" | grep -Fxq -- "${id}" && continue
					printf '%s,' "${id}"
				done)
				if [ "${all}" = yes ]; then
					accept_licenses=${keep%,}
				else
					accept_licenses=$(cut -f1 "${items}" | while IFS= read -r id; do
						case ",${keep}," in
							*",${id},"*) printf '%s,' "${id}"; continue ;;
						esac
						printf '%s\n' "${group}" | grep -Fxq -- "${id}" && printf '%s,' "${id}"
					done)
					accept_licenses=${accept_licenses%,}
				fi
				;;
			Read|Notices)
				if [ "${DLG_OUT}" = Notices ]; then
					pick=-notices-
				else
					set -- --menu 'Which licence?' 0 0 8
					while IFS="${TAB}" read -r id name flags text; do
						[ "${id}" != -notices- ] || continue
						set -- "$@" "${id}" "${name}"
					done < "${items}"
					dlg_page "$@"
					[ "${DLG_RC}" -eq 0 ] || continue
					pick=${DLG_OUT}
				fi
				file=$(awk -F '\t' -v id="${pick}" '$1 == id { print $4; exit }' "${items}")
				[ -n "${file}" ] || continue
				dlg --ok-label Close --textbox "${file}" 0 0
				;;
		esac
	done
}

page_summary() {
	DLG_TITLE="${product} Installer [Summary]"
	write_answers || die 3 'cannot write the answers'
	foreign=$(disk_plan foreign 2>>"${log}") || foreign=''
	note=''
	if [ -n "${foreign}" ]; then
		note="
${disk} holds ${foreign}: everything on it is deleted."
	fi
	dlg_yesno "$(summary_text)${note}

Choose OK to install ${product} with these settings." 0 0
	case "${DLG_RC}" in
		0) : ;;
		1) return 1 ;;
		*) return 3 ;;
	esac
	# Another system on the disk: the word, typed, as on the graphical
	# summary.  Anything else goes back to the summary.
	erase_confirmed=no
	if [ -n "${foreign}" ]; then
		dlg_page --inputbox "${disk} holds ${foreign}, and everything on it is deleted.

Type erase to confirm." 0 0 ''
		case "${DLG_RC}" in
			0) : ;;
			1) return 1 ;;
			*) return 3 ;;
		esac
		case "$(printf '%s' "${DLG_OUT}" | tr '[:upper:]' '[:lower:]' | tr -d ' ')" in
			erase) erase_confirmed=yes ;;
			*) return 1 ;;
		esac
	fi
	rm -f "${state}/secrets/plan.json"
	disk_plan write 2>>"${log}" || die 3 'cannot write the plan of the disk'
	return 0
}

# feed_gauge — the protocol bsddialog(1) reads for the gauge widget.
#
# A "PROGRESS <n> <message>" line of the install command sets the gauge to
# n and shows the message; an "ERROR <message>" line shows the message.
# Until the first PROGRESS line, every line moves the gauge on by ten.
feed_gauge() {
	count=0
	percent=0
	seen_progress=no
	while IFS= read -r line; do
		text=${line}
		case "${line}" in
			PROGRESS\ *)
				rest=${line#PROGRESS }
				n=${rest%% *}
				case "${n}" in
					''|*[!0-9]*) : ;;
					*)
						seen_progress=yes
						[ "${n}" -le 100 ] || n=100
						percent=${n}
						text=${rest#"${n}"}
						text=${text# }
						;;
				esac
				;;
			ERROR\ *) text=${line#ERROR } ;;
			*)
				if [ "${seen_progress}" = no ]; then
					count=$((count + 1))
					percent=$((count * 10))
					[ "${percent}" -le 100 ] || percent=100
				fi
				;;
		esac
		printf 'XXX\n%s\n%s\nXXX\n' "${percent}" "${text}"
	done
	printf 'EOF\n'
}

# apply_helper — the root helper of the installer, next to the libraries
# when it is installed, in bin/ of a checkout.
apply_helper() {
	if [ -x "${root}/installer-apply" ]; then
		printf '%s\n' "${root}/installer-apply"
	else
		printf '%s\n' "${root}/bin/installer-apply"
	fi
}

# privileged <command...> — run the root helper.  The front end runs as the
# user of the session; when the helper is installed (it belongs to root) and
# the user is not root, doas or sudo runs it, without asking for a password
# when there is no terminal.  Otherwise (a checkout, a rehearsal, root
# itself) the helper is run directly.
privileged() {
	_owner=$(ls -ln "$1" 2>/dev/null | awk '{ print $3 }')
	if [ "$(id -u)" != 0 ] && [ "${_owner}" = 0 ]; then
		for _tool in doas sudo; do
			if command -v "${_tool}" >/dev/null 2>&1; then
				"${_tool}" -n "$@"
				return
			fi
		done
	fi
	"$@"
}

# submit_dir — the directory the root helper reads: the answers, the hash of
# the password and nothing else.  It is the private directory of the
# secrets of the run.
submit_dir() {
	cp "${answers_file}" "${state}/secrets/answers.conf" || return 1
	chmod 600 "${state}/secrets/answers.conf" || return 1
	printf '%s\n' "${state}/secrets"
}

# run_install — install the system while the gauge widget shows the progress.
# The root helper checks every answer again and runs the installation; its
# output goes to the log and to the gauge.
run_install() {
	rm -f "${state}/install.rc"
	dir=$(submit_dir) || return 4
	helper=$(apply_helper)
	(
		# The exit code of the helper is the exit code of the run.  It
		# is caught here, so that it is written down even when the
		# installation fails: the file of the status is written after
		# the helper, and not before it.
		code=0
		privileged "${helper}" --install "${dir}" < /dev/null 2>&1 || code=$?
		printf '%s\n' "$code" > "${state}/install.rc"
	) | tee -a "${log}" | feed_gauge |
		"$BSDDIALOG" --title "${DLG_TITLE}" --gauge "Installing ${product}." \
			0 0 --output-fd 4 4>/dev/null 1>&3 2>>"${log}" || :
	if [ ! -f "${state}/install.rc" ]; then
		return 4
	fi
	result=$(cat "${state}/install.rc")
	case "${result}" in
		''|*[!0-9]*) return 4 ;;
	esac
	return "${result}"
}

# page_install_failure — the installation did not finish.  The user may run
# it again or go back to the summary.  The finished page is never reached
# after a failure.
page_install_failure() {
	publish_log || :
	dlg_page --menu "The installation did not finish.

The details are in ${log_destination}.

Choose Retry to run the installation again, or Back to return to the summary." 0 0 8 \
		Retry 'Run the installation again' \
		Back 'Return to the summary and change the answers'
	case "${DLG_RC}" in
		0)
			case "${DLG_OUT}" in
				Retry) return 4 ;;
				*) return 1 ;;
			esac
			;;
		1) return 1 ;;
		*) return 3 ;;
	esac
}

page_install() {
	DLG_TITLE="${product} Installer [Install]"
	write_answers || die 3 'cannot write the answers'
	if [ "${installed}" -eq 0 ]; then
		result=0
		"$BACKEND" disk validate >> "${log}" 2>&1 || result=$?
		if [ "${result}" -ne 0 ]; then
			# Nothing was installed, so the run is not a failed
			# installation: the flag of a failed installation stays
			# where it was.
			publish_log || :
			dlg_page --msgbox "The chosen disk cannot be used.

The details are in ${log_destination}." 0 0
			case "${DLG_RC}" in
				0) return 1 ;;
				1) return 1 ;;
				*) return 3 ;;
			esac
		fi
		printf 'the disk %s was checked before the installation\n' \
			"${disk}" >> "${log}"
		result=0
		run_install || result=$?
		delete_secrets
		if [ "${result}" -eq 0 ]; then
			installed=1
			# The installation worked, so the run is not a failed one
			# any more: a retry that works ends the run well.
			install_failed=0
		else
			install_failed=1
		fi
	fi
	if [ "${installed}" -eq 1 ]; then
		return 0
	fi
	page_install_failure
}

page_finish() {
	DLG_TITLE="${product} Installer [Finish]"
	dlg_page --msgbox "${product} is installed.

Remove the installation media and reboot." 0 0
	case "${DLG_RC}" in
		0) return 2 ;;
		1) return 1 ;;
		*) return 3 ;;
	esac
}

main() {
	mkdir -p "${state_parent}" ||
		die 3 "cannot create the state directory ${state_parent}"
	state=$(mktemp -d "${state_parent}/wtfbsd-installer.XXXXXX") ||
		die 3 'cannot create the state directory'
	chmod 700 "${state}" || die 3 'cannot make the state directory private'
	trap 'cleanup' EXIT
	trap 'signal_exit' INT TERM HUP
	export INSTALLER_STATE_DIR="${state}"
	answers_file=${INSTALLER_ANSWERS:-${state}/answers.conf}
	# The backend reads the answers from the environment, so the file the
	# front end writes has to be named there.
	export INSTALLER_ANSWERS="${answers_file}"
	# The log of the run lives in the state directory, which is private.
	# The copy that is kept is made when the run ends.
	log=${state}/installer.log
	log_destination=${INSTALLER_LOG:-${state_parent}/wtfbsd-installer.log}
	(umask 077 && : > "${log}") || :
	product=$(config_value PRODUCT_NAME) || exit 2
	default_keymap=$(config_value DEFAULT_KEYMAP) || exit 2
	os_name=$(config_value OS) || os_name=freebsd
	default_timezone=$(config_value DEFAULT_TZ) || exit 2
	# The rest of the configuration is checked as well: a configuration
	# that cannot be used stops the run before the first page.
	config_value PRODUCT_SLUG >/dev/null || exit 2
	config_value OS >/dev/null || exit 2
	hash_scheme=$(json_value "$("$BACKEND" users probe 2>>"${log}" || :)" hash_scheme)
	[ -n "${hash_scheme}" ] || hash_scheme=sha512
	if ! command -v "${BSDDIALOG}" >/dev/null 2>&1; then
		printf 'installer-tui: the dialog tool %s is not installed\n' \
			"${BSDDIALOG}" >&2
		exit 3
	fi
	result=0
	preflight || result=$?
	case "${result}" in
		0) : ;;
		5|9) leave ;;
		*)
			[ -n "${stop_reason}" ] ||
				stop_reason='the checks before the first page did not pass'
			printf 'installer-tui: the installer stopped before the first page (%s); run it again\n' \
				"${stop_reason}" >&2
			exit 1
			;;
	esac
	keymap=${default_keymap}
	timezone=${default_timezone}
	page=welcome
	while :; do
		action=0
		case "${page}" in
			welcome) page_welcome || action=$? ;;
			keyboard) page_keyboard || action=$? ;;
			timezone) page_timezone || action=$? ;;
			disk) page_disk || action=$? ;;
			users) page_users || action=$? ;;
			network) page_network || action=$? ;;
			software) page_software || action=$? ;;
			summary) page_summary || action=$? ;;
			install) page_install || action=$? ;;
			finish) page_finish || action=$? ;;
			*) die 3 "unknown page '${page}'" ;;
		esac
		if [ "${DLG_RC}" -eq 9 ]; then
			action=2
		fi
		case "${action}" in
			0) page=$(page_next "${page}") ;;
			1) page=$(page_prev "${page}") ;;
			2) leave ;;
			3)
				printf 'installer-tui: the installation was stopped\n' >&2
				exit 1
				;;
			4) : ;;
			5) leave ;;
			*) die 3 "bad action '${action}'" ;;
		esac
	done
}

main "$@"

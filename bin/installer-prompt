#!/bin/sh
# Copyright (c) 2026 The wtfbsd contributors. BSD-2-Clause (see LICENSE).
#
# installer-prompt — the questions of the text front end as plain prompts,
# for a system that has neither bsddialog(1) nor dialog(1).
#
# It takes the arguments of bsddialog for the boxes the installer uses and
# answers the way bsddialog does: the screen goes to standard output, the
# choice to the descriptor of --output-fd (standard error without it), and
# the exit code is 0 for OK or Yes, 1 for Cancel, Back or No, 5 for the
# escape key and 255 at the end of the input.  The answers are read from standard input, one line each:
#
#   <      the second button (Back, Quit, No)
#   !      the escape key (the installer then asks whether to quit)
#   a number or a tag  chooses from a list; an empty line takes the default
#
# Boxes: --msgbox, --yesno, --inputbox, --passwordbox, --menu,
# --radiolist, --checklist, --textbox (a pager of a file), --gauge.
#
# Every prompt shows its keys the same way, at its end:
#
#   [Enter: <what Enter does> · <: <the second button> · !: Quit]
#
# (with | instead of · when the locale is not UTF-8, so that a console
# without UTF-8 shows no stray bytes).

set -eu

title=''
outfd=2
ok_label=OK
cancel_label=Cancel
yes_label=Yes
no_label=No
default_item=''

while [ $# -gt 0 ]; do
	case "$1" in
		--title) title=$2; shift 2 ;;
		--output-fd) outfd=$2; shift 2 ;;
		--ok-label) ok_label=$2; shift 2 ;;
		--cancel-label) cancel_label=$2; shift 2 ;;
		--yes-label) yes_label=$2; shift 2 ;;
		--no-label) no_label=$2; shift 2 ;;
		--default-item) default_item=$2; shift 2 ;;
		--*) break ;;
		*) shift ;;
	esac
done
case "${outfd}" in
	''|*[!0-9]*) outfd=2 ;;
esac

widget=${1:-}
[ $# -ge 1 ] && shift
text=${1:-}
[ $# -ge 1 ] && shift

# The separator of the keys: a middle dot in a UTF-8 locale, a bar
# otherwise.
sep='|'
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	*[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) sep='·' ;;
esac

# keys <Enter> [<back>] — the keys of the prompt: what Enter does, the
# second button when the box has one, and the escape key.
keys() {
	if [ $# -ge 2 ]; then
		printf '[Enter: %s %s <: %s %s !: Quit]' "$1" "${sep}" "$2" "${sep}"
	else
		printf '[Enter: %s %s !: Quit]' "$1" "${sep}"
	fi
}

header() {
	printf '\n'
	[ -z "${title}" ] || printf '== %s ==\n\n' "${title}"
	printf '%s\n\n' "${text}"
}

# answer — one line of the user; the special lines end the box.  The end
# of the input is an error (255): nobody is there to answer.
answer() {
	if ! IFS= read -r line; then
		exit 255
	fi
	case "${line}" in
		'<') exit 1 ;;
		'!') exit 5 ;;
	esac
}

out() {
	printf '%s\n' "$1" >&"${outfd}"
}

# rows — the rows of the terminal: LINES, else what the terminal says, else 24.
rows() {
	_r=${LINES:-}
	case "${_r}" in
		''|*[!0-9]*) _r=$(stty size 2>/dev/null </dev/tty | cut -d' ' -f1) || _r='' ;;
	esac
	case "${_r}" in
		''|*[!0-9]*|0) _r=24 ;;
	esac
	printf '%s\n' "${_r}"
}

# show_page <file> <page> <size> — one page of the lines of a file.
show_page() {
	_from=$(( ($2 - 1) * $3 + 1 ))
	_to=$(( $2 * $3 ))
	sed -n "${_from},${_to}p" "$1"
}

# turn — + or - on a list of several pages: the next or the previous page
# is shown; succeeds when the line was one of them.
turn() {
	[ "${pages:-1}" -gt 1 ] || return 1
	case "${line}" in
		+) [ "${page}" -lt "${pages}" ] && page=$((page + 1)) ;;
		-) [ "${page}" -gt 1 ] && page=$((page - 1)) ;;
		*) return 1 ;;
	esac
	printf '\n'
	show_page "${listing}" "${page}" "${size}"
	return 0
}

# pick <default> <tags...> — the tag the line names by number or by name.
pick() {
	_default=$1
	shift
	if [ -z "${line}" ]; then
		[ -n "${_default}" ] || return 1
		chosen=${_default}
		return 0
	fi
	_i=0
	for _tag in "$@"; do
		_i=$((_i + 1))
		if [ "${line}" = "${_i}" ] || [ "${line}" = "${_tag}" ]; then
			chosen=${_tag}
			return 0
		fi
	done
	return 1
}

case "${widget}" in
	--msgbox)
		header
		printf '%s ' "$(keys "${ok_label}")"
		answer
		exit 0
		;;
	--yesno)
		header
		while :; do
			printf '%s or %s? %s ' "${yes_label}" "${no_label}" \
				"$(keys "${yes_label}" "${no_label}")"
			answer
			case "${line}" in
				''|y|Y|yes|"${yes_label}") exit 0 ;;
				n|N|no|"${no_label}") exit 1 ;;
			esac
		done
		;;
	--inputbox|--passwordbox)
		shift 2 2>/dev/null || :
		header
		printf '%s > ' "$(keys "${ok_label}" "${cancel_label}")"
		secret=no
		if [ "${widget}" = --passwordbox ] && [ -t 0 ]; then
			secret=yes
			stty -echo 2>/dev/null || :
		fi
		status=0
		IFS= read -r line || status=255
		[ "${secret}" = no ] || { stty echo 2>/dev/null || :; printf '\n'; }
		[ "${status}" -eq 0 ] || exit 255
		case "${line}" in
			'<') exit 1 ;;
			'!') exit 5 ;;
		esac
		out "${line}"
		exit 0
		;;
	--menu|--radiolist|--checklist)
		shift 3 2>/dev/null || :
		header
		listing=$(mktemp "${TMPDIR:-/tmp}/installer-prompt.XXXXXX") || exit 255
		# The listing is gone when the run ends, and a signal ends the
		# run at once: the code of the signal is the code of the run
		# (129 for HUP, 130 for INT, 143 for TERM).  A signal needs a
		# handler of its own: a handler that removes the file and
		# returns leaves the script running.
		trap 'rm -f "${listing}"' EXIT
		trap 'rm -f "${listing}"; exit 129' HUP
		trap 'rm -f "${listing}"; exit 130' INT
		trap 'rm -f "${listing}"; exit 143' TERM
		tags=''
		default=${default_item}
		selected=''
		i=0
		while [ $# -ge 2 ]; do
			tag=$1
			item=$2
			shift 2
			state=''
			if [ "${widget}" != --menu ] && [ $# -ge 1 ]; then
				state=$1
				shift
			fi
			i=$((i + 1))
			mark='   '
			case "${state}" in
				on|ON) mark='[x]'; selected="${selected} ${tag}"; [ -n "${default}" ] || default=${tag} ;;
				off|OFF) mark='[ ]' ;;
			esac
			printf '  %2d) %s %s  %s\n' "${i}" "${mark}" "${tag}" "${item}" >> "${listing}"
			tags="${tags} ${tag}"
		done
		[ -n "${default}" ] || default=${tags# }
		default=${default%% *}
		# A list longer than the screen is shown a page at a time: + and
		# - turn the pages, a number or a tag of any page picks.
		pages=1
		page=1
		count=$(grep -c . "${listing}" 2>/dev/null || echo 0)
		size=$(( $(rows) - 8 ))
		[ "${size}" -ge 3 ] || size=3
		if [ "${count}" -gt "${size}" ]; then
			pages=$(( (count + size - 1) / size ))
		fi
		show_page "${listing}" 1 "${size}"
		while :; do
			more=''
			if [ "${pages}" -gt 1 ]; then
				more=" (page ${page} of ${pages}; +: next page ${sep} -: previous page)"
			fi
			if [ "${widget}" = --checklist ]; then
				printf '\nNumbers or tags, separated by spaces%s %s > ' "${more}" \
					"$(keys 'as marked' "${cancel_label}")"
				answer
				if turn; then
					continue
				fi
				if [ -z "${line}" ]; then
					out "${selected# }"
					exit 0
				fi
				result=''
				ok=yes
				for word in ${line}; do
					line=${word}
					# shellcheck disable=SC2086
					if pick '' ${tags}; then
						result="${result} ${chosen}"
					else
						ok=no
					fi
				done
				if [ "${ok}" = yes ]; then
					out "${result# }"
					exit 0
				fi
			else
				printf '\nNumber or tag%s %s > ' "${more}" "$(keys "${default}" "${cancel_label}")"
				answer
				if turn; then
					continue
				fi
				# shellcheck disable=SC2086
				if pick "${default}" ${tags}; then
					out "${chosen}"
					exit 0
				fi
			fi
			printf 'That is not one of the choices.\n'
		done
		;;
	--textbox)
		# The text is a file, a page at a time: Enter shows the next page
		# and closes the text after the last one.
		printf '\n'
		[ -z "${title}" ] || printf '== %s ==\n\n' "${title}"
		if [ -f "${text}" ]; then
			size=$(( $(rows) - 4 ))
			[ "${size}" -ge 3 ] || size=3
			count=$(wc -l < "${text}" | tr -d ' ')
			page=1
			while :; do
				show_page "${text}" "${page}" "${size}"
				if [ $((page * size)) -lt "${count}" ]; then
					printf '\n(page %s of %s) %s ' "${page}" "$(( (count + size - 1) / size ))" \
						"$(keys 'next page')"
					answer
					page=$((page + 1))
					continue
				fi
				break
			done
		fi
		printf '\n%s ' "$(keys "${ok_label}")"
		answer
		exit 0
		;;
	--gauge)
		header
		# The protocol of the gauge: XXX, the percentage, the text, XXX.
		state=0
		percent=0
		while IFS= read -r line; do
			case "${state}:${line}" in
				*:EOF) break ;;
				0:XXX) state=1 ;;
				1:*) percent=${line}; state=2 ;;
				2:XXX) state=0 ;;
				2:*) printf '[%3s%%] %s\n' "${percent}" "${line}" ;;
			esac
		done
		exit 0
		;;
	*)
		printf 'installer-prompt: the box %s is not known\n' "${widget}" >&2
		exit 255
		;;
esac
